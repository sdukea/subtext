# Server-side only. Never prefix with NEXT_PUBLIC_.
# If unset, SubText runs in a clearly labelled development mock mode (no real AI).
ANTHROPIC_API_KEY=

# Optional model overrides (defaults follow research/08 §8.1 "Config B").
SUBTEXT_ANALYSE_MODEL=claude-haiku-5-5
SUBTEXT_COMPOSE_MODEL=claude-sonnet-5-5

# Force the development mock even when a key is present (true/false).
SUBTEXT_MOCK=false

# Number of sampled interpretations used to estimate uncertainty (research/06 §D.4 suggests ~6).
SUBTEXT_SAMPLES=5

# Requests per minute per IP for /api/session (in-memory, single instance).
SUBTEXT_RATE_LIMIT=40

# ---- Phase 0 study mode (/study researcher console) ----
# Required to use the console outside local development. Sent by the console as x-operator-key.
SUBTEXT_OPERATOR_KEY=
# Where study sessions are stored as JSON files (default ./.data, git-ignored).
SUBTEXT_DATA_DIR=
